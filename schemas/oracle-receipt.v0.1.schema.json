{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mcproof Oracle Receipt v0.1",
  "type": "object",
  "required": [
    "schema",
    "oracle",
    "passed",
    "epistemic_status",
    "checks",
    "findings",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "mcproof-receipt/v0.1"
    },
    "oracle": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "PROVEN",
        "VERIFIED",
        "KNOWN",
        "CONJECTURE",
        "IN_PROGRESS",
        "REJECTED"
      ]
    },
    "checks": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "message"],
        "properties": {
          "rule": {"type": "string"},
          "message": {"type": "string"},
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 0}
        }
      }
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
