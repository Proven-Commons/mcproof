  "methodology": {
    "eight_slot_protocol": "same prompt and sampling; 8 simultaneous requests (id_slot 0..7, all slots erased first), n_predict 96, 1 warmup per arm (n_predict 64), 5 interleaved trials; tok/s = total predicted tokens / wall-clock",
    "gpu_contention_check": "harness refuses to start unless nvidia-smi shows <= 600 MiB used and <= 20% util; both runs started at 0 MiB / 0% with no compute apps",
    "harness": "tc5_replay.py (stdlib only), a line-by-line replica of the T-C5 block in stack/src/mcproof_stack/phase6_composition.py (~L2217-2335) and LiveLlamaProcess.build_command in runtime.py",
    "kv_gate": "GET /slots: raw_slots[0].n_ctx is int >= 8192 (extract_verified_slot_n_ctx), plus all 8 slots report 8192. Additional stress test: 8 concurrent requests with 7454-token prompts + 32 generated tokens (7486 tokens resident per slot, 91.4% of 8192) under triple LoRA, with peak VRAM sampled during it",
    "lora_effect_sanity": "the stack arm's greedy output differs from W0's on every trial (content sha256 recorded), so adapters were actually applied",
    "overhead_formula": "(median_w0 - median_stack)/median_w0*100; benchmark_anomaly if < -5.0; gate passes if not anomaly and <= 15.0 (compute_latency_overhead_metrics)",
    "server_launch": "llama-server -m <gguf> --host 127.0.0.1 -c 65536 (=8192*8) -ngl 99 -np 8 --cache-type-k f16 --cache-type-v f16 --slots --slot-save-path <dir> --no-cache-idle-slots --slot-prompt-similarity 0.0 --ctx-checkpoints 0 --chat-template-kwargs {\"enable_thinking\":false} --lora-scaled corpus:0.0,weft-eido:0.0,formal-verification:0.0 --lora-init-without-apply; server log confirms n_slots=8, n_ctx_slot=8192, kv_unified=false",
    "single_slot_protocol": "POST /completion with BENCH_PROMPT from phase6_composition.py, temperature 0, top_p 1, seed 42, cache_prompt false, id_slot 0. 1 warmup per arm (n_predict 64), then 5 interleaved trials (even: W0 then stack; odd: stack then W0), slot 0 erased before each, n_predict 96. tok/s = timings.predicted_per_second",
    "stack_definition": "same server instance, per-request lora=[{id:0,scale:1},{id:1,scale:1},{id:2,scale:1}]",
    "vram": "nvidia-smi --query-gpu=memory.used polled about every 100 ms from before server launch until after shutdown (boot, both benchmarks, KV stress); peak = max sample, device-wide (includes CUDA context and cuBLAS workspace)",
    "w0_definition": "same server instance, per-request lora=[] (all three adapters loaded at scale 0, not applied)"
  },
