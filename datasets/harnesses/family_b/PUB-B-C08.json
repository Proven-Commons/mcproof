  "generator_source": "def propose_cert(inst: dict) -> dict:\n    n, edges = inst['n'], inst['edges']\n    uf = list(range(n))\n    def find(x):\n        while uf[x] != x:\n            x = uf[x]\n        return x\n    chosen = []\n    for idx in sorted(range(len(edges)), key=lambda i: edges[i][2]):\n        u, v, _ = edges[idx]\n        ru, rv = find(u), find(v)\n        if ru != rv:\n            uf[ru] = rv\n            chosen.append(idx)\n    adj = [[] for _ in range(n)]\n    for idx in chosen:\n        u, v, _ = edges[idx]\n        adj[u].append(v)\n        adj[v].append(u)\n    par, dep, q = [-1] * n, [-1] * n, [0]\n    dep[0] = 0\n    for u in q:\n        for v in adj[u]:\n            if dep[v] == -1:\n                par[v] = u\n                dep[v] = dep[u] + 1\n                q.append(v)\n    return {'tree_edges': chosen, 'parent': par, 'depth': dep, 'total_weight': sum(edges[i][2] for i in chosen)}\n",
