  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    A = [[Fraction(v, 1) for v in row] for row in inst['A']]\n    b = [Fraction(v, 1) for v in inst['b']]\n    n = len(A)\n    for col in range(n):\n        piv = next(r for r in range(col, n) if A[r][col] != 0)\n        A[col], A[piv] = A[piv], A[col]\n        b[col], b[piv] = b[piv], b[col]\n        pv = A[col][col]\n        inv_pv = Fraction(pv.denominator, pv.numerator)\n        for j in range(col, n):\n            A[col][j] *= inv_pv\n        b[col] *= inv_pv\n        for r in range(n):\n            if r != col and A[r][col] != 0:\n                fac = A[r][col]\n                for j in range(col, n):\n                    A[r][j] -= fac * A[col][j]\n                b[r] -= fac * b[col]\n    return {'x': [[v.numerator, v.denominator] for v in b]}\n",
