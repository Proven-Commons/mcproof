  "generator_source": "def propose_cert(inst: dict) -> dict:\n    n, edges = inst['n'], inst['edges']\n    adj = [[] for _ in range(n)]\n    for u, v in edges:\n        adj[u].append(v)\n        adj[v].append(u)\n    col, par = [-1] * n, [-1] * n\n    for s in range(n):\n        if col[s] != -1:\n            continue\n        col[s], q = 0, [s]\n        for u in q:\n            for v in adj[u]:\n                if col[v] == -1:\n                    col[v], par[v] = 1 - col[u], u\n                    q.append(v)\n                elif col[v] == col[u]:\n                    pu, pv = [], []\n                    x = u\n                    while x != -1:\n                        pu.append(x)\n                        x = par[x]\n                    x = v\n                    while x != -1:\n                        pv.append(x)\n                        x = par[x]\n                    lca = next(z for z in pu if z in pv)\n                    cyc = pu[:pu.index(lca)+1] + pv[:pv.index(lca)][::-1]\n                    return {'bipartite': False, 'colors': [], 'odd_cycle': cyc}\n    return {'bipartite': True, 'colors': col, 'odd_cycle': []}\n",
