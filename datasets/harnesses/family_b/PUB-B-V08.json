  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    V = [[Fraction(x, 1) for x in v] for v in inst['vectors']]\n    k, d = len(V), len(V[0])\n    Q, R = [], [[Fraction(0, 1)] * k for _ in range(k)]\n    nsq = []\n    for i in range(k):\n        u = list(V[i])\n        R[i][i] = Fraction(1, 1)\n        for j in range(i):\n            num = sum(V[i][t] * Q[j][t] for t in range(d))\n            coef = num * Fraction(nsq[j].denominator, nsq[j].numerator)\n            R[j][i] = coef\n            u = [u[t] - coef * Q[j][t] for t in range(d)]\n        Q.append(u)\n        nsq.append(sum(x * x for x in u))\n    f2 = lambda M: [[[x.numerator, x.denominator] for x in r] for r in M]\n    return {'Q': f2(Q), 'R': f2(R), 'norms_sq': [[x.numerator, x.denominator] for x in nsq]}\n",
