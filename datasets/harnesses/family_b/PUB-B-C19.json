  "entry_fn": "verify",
  "family": "B",
  "generator_source": "def propose_cert(inst: dict) -> dict:\n    serving, nxt, active, waiting = 0, 0, None, set()\n    peak = 0\n    for ev in inst['events']:\n        op = ev['op']\n        if op == 'ISSUE':\n            waiting.add((ev['client'], nxt))\n            nxt += 1\n        elif op == 'ENTER':\n            pair = (ev['client'], ev['ticket'])\n            if active is not None or ev['ticket'] != serving or pair not in waiting:\n                return {'valid_trace': False, 'final_serving': -1, 'final_next_ticket': -1, 'max_concurrent': -1}\n            waiting.remove(pair)\n            active = pair\n            peak = 1\n        elif op == 'EXIT':\n            pair = (ev['client'], ev['ticket'])\n            if active != pair:\n                return {'valid_trace': False, 'final_serving': -1, 'final_next_ticket': -1, 'max_concurrent': -1}\n            active = None\n            serving += 1\n    return {'valid_trace': True, 'final_serving': serving, 'final_next_ticket': nxt, 'max_concurrent': peak}\n",
