  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    A, b = inst['A'], inst['b']\n    n = len(A)\n    aug = [[Fraction(A[i][j], 1) for j in range(n)] + [Fraction(int(i == j), 1) for j in range(n)] for i in range(n)]\n    for c in range(n):\n        p = next(r for r in range(c, n) if aug[r][c] != 0)\n        aug[c], aug[p] = aug[p], aug[c]\n        pv = aug[c][c]\n        sc = Fraction(pv.denominator, pv.numerator)\n        aug[c] = [v * sc for v in aug[c]]\n        for r in range(n):\n            if r != c and aug[r][c] != 0:\n                f = aug[r][c]\n                aug[r] = [aug[r][k] - f * aug[c][k] for k in range(2 * n)]\n    R = [[aug[i][n + j] * Fraction(99, 100) for j in range(n)] for i in range(n)]\n    xm = [sum(R[i][j] * b[j] for j in range(n)) for i in range(n)]\n    rad = Fraction(1, 2)\n    return {'R': [[[x.numerator, x.denominator] for x in r] for r in R], 'x_mid': [[x.numerator, x.denominator] for x in xm], 'rad': [rad.numerator, rad.denominator]}\n",
