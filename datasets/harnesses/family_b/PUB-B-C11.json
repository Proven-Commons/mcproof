  "generator_source": "def propose_cert(inst: dict) -> dict:\n    n, edges = inst['n'], inst['edges']\n    adj = [[] for _ in range(n)]\n    indeg = [0] * n\n    for u, v in edges:\n        adj[u].append(v)\n        indeg[v] += 1\n    q = [i for i in range(n) if indeg[i] == 0]\n    topo = []\n    for u in q:\n        topo.append(u)\n        for v in adj[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                q.append(v)\n    if len(topo) == n:\n        return {'is_dag': True, 'topo_order': topo, 'cycle': []}\n    state, stk, cyc = [0] * n, [], []\n    def dfs(u):\n        state[u] = 1\n        stk.append(u)\n        for v in adj[u]:\n            if state[v] == 1:\n                cyc.extend(stk[stk.index(v):])\n                return True\n            if state[v] == 0 and dfs(v):\n                return True\n        stk.pop()\n        state[u] = 2\n        return False\n    for i in range(n):\n        if state[i] == 0 and dfs(i):\n            break\n    return {'is_dag': False, 'topo_order': [], 'cycle': cyc}\n",
