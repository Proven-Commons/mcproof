  "generator_source": "def propose_cert(inst: dict) -> dict:\n    readers, writer = set(), -1\n    for ev in inst['events']:\n        t, op = ev['tid'], ev['op']\n        if op == 'ACQ_R':\n            if writer != -1 or t in readers:\n                return {'safe': False, 'final_readers': [], 'final_writer': -1}\n            readers.add(t)\n        elif op == 'REL_R':\n            if t not in readers:\n                return {'safe': False, 'final_readers': [], 'final_writer': -1}\n            readers.remove(t)\n        elif op == 'ACQ_W':\n            if writer != -1 or readers:\n                return {'safe': False, 'final_readers': [], 'final_writer': -1}\n            writer = t\n        elif op == 'REL_W':\n            if writer != t:\n                return {'safe': False, 'final_readers': [], 'final_writer': -1}\n            writer = -1\n    return {'safe': True, 'final_readers': sorted(readers), 'final_writer': writer}\n",
