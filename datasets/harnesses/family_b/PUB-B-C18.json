  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    n = len(inst['A'])\n    U = [[Fraction(v, 1) for v in r] for r in inst['A']]\n    L = [[Fraction(0, 1)] * n for _ in range(n)]\n    perm = list(range(n))\n    for k in range(n):\n        p = max(range(k, n), key=lambda i: abs(U[i][k]))\n        U[k], U[p] = U[p], U[k]\n        perm[k], perm[p] = perm[p], perm[k]\n        L[k][:k], L[p][:k] = L[p][:k], L[k][:k]\n        L[k][k] = Fraction(1, 1)\n        if U[k][k] == 0:\n            continue\n        inv_u = Fraction(U[k][k].denominator, U[k][k].numerator)\n        for i in range(k + 1, n):\n            fac = U[i][k] * inv_u\n            L[i][k] = fac\n            for j in range(k, n):\n                U[i][j] -= fac * U[k][j]\n    fmt = lambda M: [[[x.numerator, x.denominator] for x in r] for r in M]\n    return {'perm': perm, 'L': fmt(L), 'U': fmt(U)}\n",
