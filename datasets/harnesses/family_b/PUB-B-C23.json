  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    ls = inst['leases']\n    disj = all(Fraction(*ls[i]['expiry']) <= Fraction(*ls[i + 1]['start']) for i in range(len(ls) - 1))\n    if not disj:\n        return {'disjoint_leases': False, 'accepted_writes': []}\n    lmap = {x['token']: (x['leader'], Fraction(*x['start']), Fraction(*x['expiry'])) for x in ls}\n    hi, acc = 0, []\n    for w in inst['writes']:\n        t, ts = w['token'], Fraction(*w['ts'])\n        info = lmap.get(t)\n        good = info is not None and info[0] == w['leader'] and t >= hi and info[1] <= ts < info[2]\n        if good:\n            hi = t\n        acc.append(good)\n    return {'disjoint_leases': True, 'accepted_writes': acc}\n",
