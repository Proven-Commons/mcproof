  "generator_source": "def propose_cert(inst: dict) -> dict:\n    cap = inst['capacity']\n    buf, head, count, popped, dropped = [0] * cap, 0, 0, [], 0\n    for item in inst['ops']:\n        if item['op'] == 'PUSH':\n            if count < cap:\n                buf[(head + count) % cap] = item['val']\n                count += 1\n            else:\n                dropped += 1\n        else:\n            if count > 0:\n                popped.append(buf[head])\n                head = (head + 1) % cap\n                count -= 1\n    rem = [buf[(head + k) % cap] for k in range(count)]\n    return {'popped': popped, 'remaining': rem, 'dropped_count': dropped}\n",
