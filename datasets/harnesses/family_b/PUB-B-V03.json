  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    f = Fraction(inst['num'], inst['den'])\n    n, d = f.numerator, f.denominator\n    coeffs = []\n    while d != 0:\n        q, r = n // d, n % d\n        coeffs.append(q)\n        n, d = d, r\n    p2, p1, q2, q1, convs = 0, 1, 1, 0, []\n    for a in coeffs:\n        p, q = a * p1 + p2, a * q1 + q2\n        convs.append([p, q])\n        p2, p1, q2, q1 = p1, p, q1, q\n    return {'coeffs': coeffs, 'convergents': convs}\n",
