  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    M = [[Fraction(v, 1) for v in r] for r in inst['A']]\n    m, n = len(M), len(M[0])\n    piv_cols, r = [], 0\n    for c in range(n):\n        p = next((i for i in range(r, m) if M[i][c] != 0), None)\n        if p is None:\n            continue\n        M[r], M[p] = M[p], M[r]\n        pv = M[r][c]\n        sc = Fraction(pv.denominator, pv.numerator)\n        M[r] = [x * sc for x in M[r]]\n        for i in range(m):\n            if i != r and M[i][c] != 0:\n                f = M[i][c]\n                M[i] = [M[i][j] - f * M[r][j] for j in range(n)]\n        piv_cols.append(c)\n        r += 1\n    from itertools import combinations\n    def det(sub):\n        k = len(sub)\n        if k == 0: return 1\n        if k == 1: return sub[0][0]\n        return sum((1 if j % 2 == 0 else -1) * sub[0][j] * det([rw[:j] + rw[j+1:] for rw in sub[1:]]) for j in range(k))\n    prows = []\n    for comb in combinations(range(m), r):\n        if det([[inst['A'][ri][ci] for ci in piv_cols] for ri in comb]) != 0:\n            prows = list(comb)\n            break\n    free_cols = [c for c in range(n) if c not in piv_cols]\n    basis = []\n    for fc in free_cols:\n        vec = [Fraction(0, 1)] * n\n        vec[fc] = Fraction(1, 1)\n        for idx, pc in enumerate(piv_cols):\n            vec[pc] = -M[idx][fc]\n        basis.append([[x.numerator, x.denominator] for x in vec])\n    return {'rank': r, 'pivot_rows': prows, 'pivot_cols': piv_cols, 'free_cols': free_cols, 'null_basis': basis}\n",
