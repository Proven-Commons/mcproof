  "generator_source": "def propose_cert(inst: dict) -> dict:\n    a, b, c, lo, hi = inst['a'], inst['b'], inst['c'], inst['x_lo'], inst['x_hi']\n    r0, r1, s0, s1, t0, t1 = a, b, 1, 0, 0, 1\n    while r1:\n        q = r0 // r1\n        r0, r1, s0, s1, t0, t1 = r1, r0 - q * r1, s1, s0 - q * s1, t1, t0 - q * t1\n    sols = []\n    for x in range(lo, hi + 1):\n        rem = c - a * x\n        if rem % b == 0:\n            sols.append([x, rem // b])\n    return {'gcd': r0, 'bezout_u': s0, 'bezout_v': t0, 'solutions': sols}\n",
