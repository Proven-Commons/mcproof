  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    out = []\n    for row in inst['A_iv']:\n        lo_s, hi_s = Fraction(0, 1), Fraction(0, 1)\n        for a_iv, x_iv in zip(row, inst['x_iv']):\n            alo, ahi = Fraction(*a_iv[0]), Fraction(*a_iv[1])\n            xlo, xhi = Fraction(*x_iv[0]), Fraction(*x_iv[1])\n            prods = (alo * xlo, alo * xhi, ahi * xlo, ahi * xhi)\n            lo_s += min(prods)\n            hi_s += max(prods)\n        out.append([[lo_s.numerator, lo_s.denominator], [hi_s.numerator, hi_s.denominator]])\n    return {'y_exact_iv': out}\n",
