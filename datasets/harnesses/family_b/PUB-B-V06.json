  "generator_source": "def propose_cert(inst: dict) -> dict:\n    n, edges = inst['n'], inst['edges']\n    adj = [[] for _ in range(n)]\n    for eid, (u, v) in enumerate(edges):\n        adj[u].append((v, eid))\n        if u != v:\n            adj[v].append((u, eid))\n    used = [False] * len(edges)\n    vstk, estk, vout, eout = [0], [], [], []\n    while vstk:\n        u = vstk[-1]\n        while adj[u] and used[adj[u][-1][1]]:\n            adj[u].pop()\n        if adj[u]:\n            v, eid = adj[u].pop()\n            used[eid] = True\n            vstk.append(v)\n            estk.append(eid)\n        else:\n            vout.append(vstk.pop())\n            if estk:\n                eout.append(estk.pop())\n    return {'vertices': vout[::-1], 'edge_order': eout[::-1]}\n",
