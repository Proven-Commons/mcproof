  "generator_source": "from fractions import Fraction\ndef propose_cert(inst: dict) -> dict:\n    m, n, r = inst['m'], inst['n'], inst['r']\n    N = m + n\n    tri = [[1] * (i + 1) for i in range(N + 1)]\n    for i in range(2, N + 1):\n        for j in range(1, i):\n            tri[i][j] = tri[i - 1][j - 1] + tri[i - 1][j]\n    tot = tri[N][r]\n    ws = []\n    for k in range(r + 1):\n        ck = tri[m][k] if k <= m else 0\n        crk = tri[n][r - k] if (r - k) <= n else 0\n        f = Fraction(ck * crk, tot)\n        ws.append([f.numerator, f.denominator])\n    return {'total_binom': tot, 'weights': ws}\n",
